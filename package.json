{
  "name": "casino-",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npx prisma generate && tsc && node src/scripts/copyAssets.js",
    "typecheck": "tsc --noEmit",
    "test:penalties": "ts-node src/scripts/penaltyServiceTests.ts",
    "test:profile-effects": "ts-node src/scripts/activeItemEffectTests.ts",
    "test:loaded-dice": "ts-node src/scripts/loadedDiceTests.ts",
    "test:starter-chicken": "ts-node src/scripts/starterChickenTests.ts",
    "test:heat": "ts-node src/scripts/heatConfigTests.ts",
    "sync:shop-emojis": "ts-node src/scripts/syncShopApplicationEmojis.ts",
    "validate:shop-emojis": "ts-node src/scripts/syncShopApplicationEmojis.ts --dry-run",
    "start": "node dist/index.js",
    "prisma:push": "npx prisma db push",
    "prisma:generate": "npx prisma generate",
    "prisma:studio": "npx prisma studio",
    "seed": "ts-node prisma/seed.ts",
    "postinstall": "npx prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --dir test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BEAST6869/Casino-.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/BEAST6869/Casino-/issues"
  },
  "homepage": "https://github.com/BEAST6869/Casino-#readme",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^5.22.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.13",
    "canvas": "^3.2.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "ioredis": "^5.9.1",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "prisma": "^5.22.0",
    "puppeteer": "^24.36.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "mongodb-memory-server": "^11.2.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
