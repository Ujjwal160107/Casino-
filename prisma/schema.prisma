generator client {
  provider = "prisma-client-js"
}

generator clientDashboard {
  provider = "prisma-client-js"
  output   = "../dashboard/node_modules/.prisma/client"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Models adapted for MongoDB (ObjectId fields).

model User {
  discordId   String @id @map("_id")
  username    String

  wallet      Wallet?
  bank        Bank?
  creditCard  CreditCard?

  creditScore Int @default(500)
  
  // XP System
  xp          Int       @default(0)
  level       Int       @default(0)

  // User preferences
  // Removed profileTheme 

  bets        Bet[]
  inventory   Inventory[] // Relation to Inventory items
  
    lastDaily   DateTime?
    lastLoadedDiceRoll DateTime?
    crimeHeat Int @default(0)
    lastHeatDecayAt DateTime?
    lastLayLowAt DateTime?
    lastHeatFixerAt DateTime?
    lastWeekly  DateTime?
    lastMonthly DateTime?
    lastVote    DateTime?
    lastVoteReminder DateTime?
    voteReminder Boolean @default(true)
    remindersEnabled    Boolean  @default(true)
    disabledReminders   String[] @default([])
    reminderDmFailCount Int      @default(0)
    globalAnnouncementFormFilled Boolean? @default(false)
    globalAnnouncementReminderDate DateTime?
    globalAnnouncementReminderCount Int? @default(0)
  
    createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  


  // Ban System
  isBanned    Boolean  @default(false)
  banExpiresAt DateTime?
  investments Investment[]
  listings    MarketListing[]
  activeEffects ActiveEffect[]
  
  // BitLife Stats (0-100)
  intelligence Int      @default(50)
  discipline   Int      @default(50)
  
  // Education Relations
  currentEducation UserEducation?
  degrees          UserDegree[]
  // Scholarship milestones ever claimed, as "<degreeId>:<milestone>". Kept on
  // the user because dropout deletes UserEducation; absent on older docs (= []).
  scholarshipClaims String[] @default([])
  
  // Employment
  jobId       String?   // Static ID from jobService (e.g., "tech_intern")
  jobStress   Int       @default(0)
  jobStreak   Int       @default(0)
  jobFailStreak Int     @default(0) // Consecutive shift failures — demote after 3
  shiftsWorked Int      @default(0) // Lifetime successful shifts — never reset, gates job requirements

  lastShift   DateTime?

  // Life Sim Relations
  workLogs    WorkLog[]
  portfolio   Portfolio?
  properties  OwnedProperty[]

  // Marriage Relations
  lastDivorcedAt DateTime?
  marriagesAsSpouse1 Marriage[] @relation("Spouse1")
  marriagesAsSpouse2 Marriage[] @relation("Spouse2")
  marriageVaultRequestsMade MarriageVaultRequest[] @relation("MarriageVaultRequester")
  marriageVaultRequestsReceived MarriageVaultRequest[] @relation("MarriageVaultSpouse")
  
  dailyQuests DailyQuest[]


  // Jail System
  isJailed        Boolean  @default(false)
  jailReleaseTime DateTime?

  // Hunt / Zoo System
  lastZooClaim    DateTime?
  caughtAnimals   CaughtAnimal[]

  // Quest System
  questStreak       Int       @default(0)
  lastQuestComplete DateTime?
}

model WorkLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  user      User     @relation(fields: [userId], references: [discordId])
  jobId     String
  shiftType String   // e.g., "button", "typing"
  success   Boolean
  earnings  Float
  createdAt DateTime @default(now())
}

model JobReputation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  sector    String
  rep       Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sector])
  @@index([userId])
}

model CreditCard {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  user                  User     @relation(fields: [userId], references: [discordId])
  userId                String   @unique
  tier                  String
  status                String   @default("ACTIVE")
  creditLimit           Int
  currentBalance        Int      @default(0)
  statementBalance      Int      @default(0)
  minimumDue            Int      @default(0)
  weeklyInterestPct     Int
  weeklySpendCap        Int
  weeklyWithdrawCap     Int
  spentThisCycle        Int      @default(0)
  withdrawnThisCycle    Int      @default(0)
  paidThisCycle         Int      @default(0)
  dueSatisfiedThisCycle Boolean  @default(false)
  missStreak            Int      @default(0)
  lastStatementAt       DateTime?
  nextStatementAt       DateTime?
  dueAt                 DateTime?
  currentCycleKey       String?
  lastPaymentAt         DateTime?
  lastPaymentAmount     Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  transactions          CardTransaction[]
  statements            CardStatement[]
}

model CardTransaction {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  card      CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId    String     @db.ObjectId
  type      String
  amount    Int
  cycleKey  String?
  meta      Json?
  createdAt DateTime   @default(now())
}

model CardStatement {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  card              CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId            String     @db.ObjectId
  cycleKey          String
  statementAt       DateTime
  dueAt             DateTime
  statementBalance  Int
  minimumDue        Int
  amountPaid        Int        @default(0)
  interestCharged   Int        @default(0)
  lateFeeCharged    Int        @default(0)
  status            String     @default("OPEN")
  scoreDeltaApplied Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([cardId, cycleKey])
}

model Wallet {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  user         User          @relation(fields: [userId], references: [discordId])
  userId       String        @unique
  balance      Float         @default(0)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  walletId  String   @db.ObjectId
  amount    Float
  type      String   // e.g.: income, admin_add, wallet_to_bank, bank_to_wallet, bet, payout, transfer_sent, transfer_recv
  meta      Json?
  isEarned  Boolean? @default(false)
  createdAt DateTime @default(now())
}



model Bet {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  user      User        @relation(fields: [userId], references: [discordId])
  userId    String
  gameId    String
  amount    Float
  choice    String?
  result    String?
  payout    Float?
  createdAt DateTime    @default(now())
}

model Job {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String
  key         String @unique
  name        String
  minPay      Float
  maxPay      Float
  successRate Float?
  cooldown    Int
  minIntelligence Int @default(0) // Requirement
  
  // Requirements
  requiredDegreeId String? @db.ObjectId
  requiredDegree   Degree? @relation(fields: [requiredDegreeId], references: [id])
  

}

model ShopItem {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId      String
  catalogKey   String?  @unique
  name         String
  description  String   @default("No description")
  price        Float
  stock        Int      @default(-1) // -1 = unlimited
  roleId       String?  // Deprecated, use effects instead
  
  // Dynamic item system
  itemType     String   @default("COLLECTIBLE") // CONSUMABLE, ROLE, BUFF, COLLECTIBLE, EQUIPMENT, UNI_BOOK
  category     String   @default("GENERAL") // GENERAL, EDUCATION, GAMES, JOBS
  effects      Json?    // Array of effect objects
  consumable   Boolean  @default(false)
  maxUses      Int?     // For consumables, null = unlimited uses
  
  // New Configs
  requirements Json?    @default("{}") // { roles: string[], items: string[], balance: number }
  onBuyActions Json?    @default("[]") // [{ type: "MSG" | "ADD_ROLE" | "REMOVE_ROLE", value: string }]
  expiresIn    Int?     // Seconds
  showInInventory Boolean @default(true)
  usable       Boolean  @default(false)
  image        String?
  emoji        String?

  // Relations
  inventory    Inventory[]
  marketListings MarketListing[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// FIX: Added 'user' relation field to match 'inventory' in User model
model Inventory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  
  // This relation connects back to the User model
  user        User     @relation(fields: [userId], references: [discordId])
  userId      String
  
  shopItem    ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)
  shopItemId  String   @db.ObjectId
  
  amount      Int      @default(1)
  meta        Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, shopItemId])
}

model Audit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId   String?
  userId    String?
  type      String 
  meta      Json?
  createdAt DateTime @default(now())
}

model Bank {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [discordId])
  userId    String   @unique
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Investment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  user         User     @relation(fields: [userId], references: [discordId])
  userId       String
  type         String   // FD, RD
  amount       Float
  interestRate Int      // Stored as percentage
  startDate    DateTime @default(now())
  maturityDate DateTime
  status       String   // ACTIVE, COMPLETED, WITHDRAWN

  // Written once, when the deposit matures. Optional on purpose: `db push`
  // does not backfill, and Prisma's Mongo connector throws reading a required
  // field that a document lacks. Legacy COMPLETED rows never get these, so
  // history filters on `completedAt: { isSet: true }`.
  completedAt    DateTime?
  interestEarned Float?   // what the deposit earned before the bank cap
  payout         Float?   // what was actually credited to the bank

  updatedAt    DateTime @updatedAt
}

model GuildSettings {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId   String   @unique
  prefix    String   @default("!")

  // Whether !rob is allowed in this server. Optional rather than
  // `Boolean @default(true)` on purpose: `db push` does not backfill existing
  // documents, and Prisma's Mongo connector throws reading a required field
  // that is absent from a document. Every existing guild would break on the
  // deploy. Callers read it as `robEnabled ?? true`, so a missing field means
  // enabled and no backfill is needed.
  robEnabled Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketListing {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  seller      User     @relation(fields: [sellerId], references: [discordId])
  sellerId    String

  shopItem    ShopItem? @relation(fields: [shopItemId], references: [id])
  shopItemId  String?   @db.ObjectId

  property    Property? @relation(fields: [propertyId], references: [id])
  propertyId  String?   @db.ObjectId

  amount      Int
  totalPrice  Int
  expiresAt   DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActiveEffect {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  user       User     @relation(fields: [userId], references: [discordId])
  userId     String
  
  effectType String   // LUCK_BOOST, etc.
  value      Float    // Multiplier value or amount
  meta       Json?
  expiresAt  DateTime?
  
  createdAt  DateTime @default(now())
  
  @@index([userId, expiresAt])
}

// --- ADVANCED EDUCATION SYSTEM ---

model Degree {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId         String
  catalogKey      String?  @unique
  name            String
  type            String   // HS, ASSOCIATE, BACHELORS, MASTERS, PHD, TRADE, CERTIFICATE
  
  // Requirements
  minIntelligence Int      @default(0) // 0-100
  requiredDegreeId String? @db.ObjectId // Prerequisite
  
  // Structure
  totalSemesters  Int      @default(8) // Standard 4-year degree (8 sem)
  passGpa         Float    @default(2.0)
  
  // Financial
  tuitionPerSem   Float    @default(1000)
  
  // XP Progression
  xpRequired      Int      @default(600) // XP needed to take the final exam

  // Perks (Passive)
  intelligenceBoost Int    @default(0) // Permanent stat boost on completion
  incomeMulti     Float    @default(0.1) // Additive multiplier
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  requiredForJobs Job[]
  prereqFor       Degree[] @relation("DegreePrereq")
  
  requiredDegree  Degree?  @relation("DegreePrereq", fields: [requiredDegreeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  activeStudents  UserEducation[]
  graduates       UserDegree[]
}

model UserEducation {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  user            User     @relation(fields: [userId], references: [discordId])
  userId          String   @unique // Can only be enrolled in one at a time? Yes for now.
  
  degree          Degree   @relation(fields: [degreeId], references: [id])
  degreeId        String   @db.ObjectId
  
  // Progress
  currentSemester Int      @default(1)
  currentGpa      Float    @default(3.0) // Legacy cosmetic field
  creditsEarned   Int      @default(0)
  educationXp     Int      @default(0)  // Primary progression stat
  
  // Sim Stats
  stress          Int      @default(0) // 0-100. High stress = dropout risk.
  attendance      Int      @default(100) // %
  lastStudy       DateTime? 
  
  status          String   @default("ENROLLED") // ENROLLED, PROBATION, DROPPED, GRADUATED
  scholarshipsClaimed Int[] @default([]) 
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserDegree {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  user            User     @relation(fields: [userId], references: [discordId])
  userId          String
  
  degree          Degree   @relation(fields: [degreeId], references: [id])
  degreeId        String   @db.ObjectId
  
  finalGpa        Float    // Legacy field; new graduations store XP in finalXp
  finalXp         Int?
  obtainedAt      DateTime @default(now())
  
  @@unique([userId, degreeId])
}


// --- STOCK MARKET ---


// --- PROPERTY MODULE ---

model Property {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  guildId     String
  key         String
  name        String
  description String
  
  // Pricing mechanics
  basePrice   Float
  price       Float    // Current system price (fluctuates)
  totalSold   Int      @default(0) // Impacts price fluctuation
  
  incomePerCycle Float
  incomeCycleHours Int @default(24)
  imageUrl    String? // Can be overridden, otherwise uses banner
  
  maxPerUser  Int      @default(1)
  isPublic    Boolean  @default(true) // For admin toggling
  meta        Json?    // e.g. { "maxAnimals": 5 } for zoo properties

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owners      OwnedProperty[]
  listings    MarketListing[] // Relations

  @@unique([key])
}

model OwnedProperty {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  user        User     @relation(fields: [userId], references: [discordId])
  userId      String
  
  property    Property @relation(fields: [propertyId], references: [id])
  propertyId  String   @db.ObjectId
  
  purchasedPrice Float   // To track ROI
  purchasedAt DateTime @default(now())
  lastCollected DateTime @default(now())
  
  @@unique([userId, propertyId])
}

model Stock {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  symbol        String   @unique
  name          String
  currentPrice  Float
  previousPrice Float    @default(0)
  basePrice     Float    @default(100)
  volatility    Int      @default(5)
  liquidity     Float    @default(1000)

  status        String   @default("ACTIVE") // ACTIVE | DELISTING | DELISTED
  delistWatch   Int      @default(0)

  trendTicksLeft Int     @default(0)
  trendPerTick   Float   @default(0)

  lastUpdate    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  holdings      StockHolding[]
  events        StockEvent[]
}

model StockEvent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  stock        Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
  stockId      String   @db.ObjectId
  symbol       String

  type          String   // MINOR_DIP | MINOR_GAIN | SLUMP | RALLY | CRASH | BOOM
  direction     String   // UP | DOWN
  magnitudePct  Float    // total move; for SLUMP this is the per-tick move
  durationTicks Int      @default(1) // >1 only for multi-tick events (SLUMP)
  telegraphed   Boolean  @default(false)

  status        String   // FORECAST | RESOLVED | FAKEOUT
  forecastTick  Int
  resolveTick   Int

  createdAt    DateTime @default(now())

  @@index([symbol, status])
  @@index([resolveTick])
}

model Portfolio {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  user         User     @relation(fields: [userId], references: [discordId])
  userId       String   @unique
  
  holdings     StockHolding[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StockHolding {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  portfolioId  String    @db.ObjectId
  
  stock        Stock     @relation(fields: [stockId], references: [id])
  stockId      String    @db.ObjectId
  
  quantity     Int
  avgBuyPrice  Float     // Average price paid per share (for profit calc)
  
  updatedAt    DateTime  @updatedAt

  @@unique([portfolioId, stockId])
}

model Marriage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  
  spouse1   User     @relation("Spouse1", fields: [spouse1Id], references: [discordId])
  spouse1Id String
  
  spouse2   User     @relation("Spouse2", fields: [spouse2Id], references: [discordId])
  spouse2Id String
  
  marriedAt DateTime @default(now())
  
  affection Int      @default(0)
  jointBalance Float @default(0)

  lastAffectionActionAt DateTime?
  lastHugAt             DateTime?
  lastKissAt            DateTime?
  lastMakeLoveAt        DateTime?
  lastDateAt            DateTime?
  lastChaosAt           DateTime?
  decayWarnings         Int       @default(0)
  lastDecayAt           DateTime?
  lastDrama             String?

  vaultRequests MarriageVaultRequest[]
  
  @@unique([spouse1Id]) // User can only be spouse1 once
  @@unique([spouse2Id]) // User can only be spouse2 once
  // Application logic must enforce that a user is not BOTH spouse1 and spouse2 in different records
}

model MarriageVaultRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  marriage   Marriage @relation(fields: [marriageId], references: [id], onDelete: Cascade)
  marriageId String   @db.ObjectId

  requester   User   @relation("MarriageVaultRequester", fields: [requesterId], references: [discordId])
  requesterId String

  spouse   User   @relation("MarriageVaultSpouse", fields: [spouseId], references: [discordId])
  spouseId String

  amount     Float
  status     String   @default("PENDING")
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([marriageId, status])
  @@index([requesterId])
  @@index([spouseId])
}

model DailyQuest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  user          User     @relation(fields: [userId], references: [discordId])
  userId        String
  dayKey        String
  tasks         Json
  completed     Boolean  @default(false)
  rewardClaimed Boolean  @default(false)
  totalReward   Int      @default(0)
  streakBonus   Int      @default(0)
  rerollsUsed   Int      @default(0)
  assignedAt    DateTime @default(now())
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, dayKey])
}

// --- HUNT / ZOO SYSTEM ---

model CaughtAnimal {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  discordId      String
  animalKey      String
  partsAvailable Json     // string[] of remaining part keys
  inZoo          Boolean  @default(false)
  fedUntil       DateTime?
  caughtAt       DateTime @default(now())
  user           User     @relation(fields: [discordId], references: [discordId])

  @@index([discordId])
}

model HuntPartInventory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String
  partKey   String
  amount    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, partKey])
  @@index([userId])
}

model HuntPartListing {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  sellerId   String
  partKey    String
  amount     Int
  totalPrice Float
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([sellerId])
  @@index([partKey])
  @@index([expiresAt])
}

model UserCraftUnlock {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String
  recipeKey   String
  unlockedAt  DateTime @default(now())

  @@unique([userId, recipeKey])
  @@index([userId])
}

model AskBlock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}


model CooldownReminder {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  discordId String
  type      String
  dueAt     DateTime
  createdAt DateTime @default(now())

  @@unique([discordId, type])
  @@index([dueAt])
}

// ── Crime Families (spec 14.1). User references are bare snowflake strings. ──

model Family {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  nameKey        String   @unique
  tag            String
  tagKey         String   @unique
  bossId         String                       // CAS target for chair moves
  level          Int      @default(1)
  xp             Int      @default(0)
  treasury       Float    @default(0)
  earnings       Float    @default(0)
  homeGuildId    String
  homeChannelId  String
  nextCaperAt    DateTime @default(now())
  lastPaydayAt   DateTime @default(now())
  lastRenamedAt  DateTime @default(now())
  duesDayKey     String   @default("")        // "YYYY-MM-DD" UTC
  duesArrears    Int      @default(0)
  warWins        Int      @default(0)
  claimNoticeFor String   @default("")        // bossId whose inactivity S23 was posted for (CAS, once per episode)
  claimChannelId String   @default("")
  claimMessageId String   @default("")
  memberCount        Int      @default(1)     // denormalized; written with every member create/delete (A9)
  activeMembers      Int      @default(0)     // written by the daily census (A22)
  censusAt           DateTime @default(now())
  recruiting         Boolean  @default(false)
  recruitPitch       String   @default("")
  recruitMinNetWorth Float    @default(0)
  recruitMinShifts   Int      @default(0)
  recruitMinAgeDays  Int      @default(0)
  recruitMinHeists   Int      @default(0)
  recruitEditedAt    DateTime @default(now())
  appDigestAt        DateTime @default(now()) // CAS: officer digest
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt          // touched by create/plan/accept/invite/leave/kick/promote so payday and disband conflict
  @@index([xp])
  @@index([warWins])
  @@index([recruiting, level])
  @@index([recruiting, memberCount])
  @@index([recruiting, activeMembers])
}

model FamilyMember {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  familyId       String   @db.ObjectId
  userId         String   @unique             // one family per account
  role           String                       // BOSS|UNDERBOSS|CAPO|SOLDIER
  roleSlot       String                       // "BOSS"|"UNDERBOSS"|"CAPO1".."CAPO6"|userId
  seat           Int                          // 1..30
  joinedAt       DateTime @default(now())
  lastActiveAt   DateTime @default(now())
  depositDayKey  String   @default("")
  depositedToday Float    @default(0)
  deposited      Float    @default(0)         // lifetime, display only
  capers         Int      @default(0)         // lifetime started seats
  correctHits    Int      @default(0)         // lifetime
  bossedOnce     Boolean  @default(false)     // CAS: firstBossAt written once (A40)
  firstBossAt    DateTime @default(now())     // read only with bossedOnce:true
  officerUntil   DateTime @default(now())     // start_vote after a demotion out of Underboss/Capo (A41)
  @@unique([familyId, roleSlot])
  @@unique([familyId, seat])
  @@index([familyId])
}

model FamilyExit {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  userId   String
  familyId String   @db.ObjectId
  reason   String                             // LEFT|KICKED|DISBANDED
  wasBoss  Boolean  @default(false)
  leftAt   DateTime @default(now())
  @@index([userId, leftAt])
  @@index([familyId, userId, leftAt])
}

model FamilyInvite {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  familyId   String   @db.ObjectId
  inviterId  String
  inviteeId  String
  kind       String   @default("INVITE")      // INVITE|APPLICATION
  message    String   @default("")
  status     String   @default("PENDING")     // PENDING|ACCEPTED|DECLINED|EXPIRED|WITHDRAWN
  slot       String   @default("PENDING")     // rewritten to id when resolved
  guildId    String
  channelId  String
  messageId  String   @default("")
  expiresAt  DateTime
  resolvedAt DateTime @default(now())         // rewritten at resolution; filtered only with status
  createdAt  DateTime @default(now())
  @@unique([familyId, inviteeId, slot])
  @@index([inviteeId, status])
  @@index([inviterId, status, resolvedAt])
  @@index([familyId, status, resolvedAt])
  @@index([status, expiresAt])
  @@index([familyId, kind, status, createdAt])
  @@index([inviteeId, kind, status])
}

model FamilyLedger {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  familyId      String   @db.ObjectId
  actorId       String                        // discordId or "system"
  type          String   // create_fee|deposit|deposit_tax|payday|payday_tax|caper_cut|racket_income|racket_neglect|dues|dues_missed|level_fee|rename_fee|bid_escrow|bid_refund|war_bid_burn|disband_burn|payday_clamp_return
  amount        Float                         // signed, vault perspective
  treasuryAfter Float
  earningsAfter Float
  meta          Json?                         // display only
  createdAt     DateTime @default(now())
  @@index([familyId, createdAt])
  @@index([actorId, createdAt])
}

model Caper {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  familyId      String   @db.ObjectId
  tier          Int
  status        String   @default("LOBBY")    // LOBBY|RUNNING|SETTLING|RESOLVED|CANCELLED
  liveSlot      String   @default("LIVE")     // rewritten to id when RESOLVED/CANCELLED
  plannerId     String
  guildId       String
  channelId     String
  messageId     String   @default("")
  lobbyClosesAt DateTime
  seatsVersion  Int      @default(0)          // written by join/leave/kick/start/cancel so they conflict
  startedAt     DateTime @default(now())      // rewritten at Start; counted only with a started status
  goEndsAt      DateTime @default(now())      // rewritten at Start; filtered only with status RUNNING
  answers       Json?                         // written at Start, read by brief/resolve, never filtered
  edge          Float    @default(0)
  heatSnapshot  Int      @default(0)
  roll          Float    @default(-1)
  outcome       String   @default("")         // ""|CLEAN|MESSY|BUST|CANCELLED|VOID
  pool          Float    @default(0)
  crewShare     Float    @default(0)
  vaultPaid     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([familyId, liveSlot])
  @@index([status, lobbyClosesAt])
  @@index([status, goEndsAt])
  @@index([familyId, status, startedAt])
}

model CaperCrew {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  caperId     String   @db.ObjectId
  familyId    String   @db.ObjectId
  userId      String
  role        String                          // MASTERMIND|LOOKOUT|SAFECRACKER|DRIVER|MUSCLE|HACKER
  liveSlot    String   @default("LIVE")       // rewritten to caperId when resolved/cancelled
  stake       Float
  started     Boolean  @default(false)
  startedAt   DateTime @default(now())        // rewritten at Start; counted only with started:true
  itemBonus   Float    @default(0)
  briefOpened Boolean  @default(false)
  briefOpenedAt DateTime @default(now())      // rewritten at first open; read only with briefOpened:true (8.3 darkness)
  choice      Int      @default(-1)           // sentinel, CAS target
  leaked      Boolean  @default(false)        // display only: this seat locked after seeing leaked intel
  refunded    Boolean  @default(false)        // CAS on cancel/VOID refunds (rows are kept)
  passed      Boolean  @default(false)
  cut         Float    @default(0)
  fine        Float    @default(0)
  jailed      Boolean  @default(false)
  settled     Boolean  @default(false)        // CAS: money + heat + jail done
  joinedAt    DateTime @default(now())
  @@unique([caperId, role])
  @@unique([caperId, userId])
  @@unique([userId, liveSlot])
  @@index([userId, started, startedAt])
  @@index([caperId, settled])
  @@index([started, startedAt])               // the census groupBy (§6.4)
}

model Racket {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  key            String   @unique
  name           String
  class          String                       // CORNER|DISTRICT|CROWN
  incomePerCycle Float
  baseDefense    Int                          // per-block baseline for any defender (9.1)
  warDow         Int                          // 0 = Sunday (getUTCDay)
  warHourUtc     Int
  ownerFamilyId  String   @default("")        // "" = Street (sentinel, never null)
  capturedAt     DateTime @default(now())
  lastPayoutAt   DateTime @default(now())
  neglectStrikes Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([ownerFamilyId])
}

model War {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  racketId          String   @db.ObjectId
  racketKey         String
  periodKey         String                    // ISO week of startsAt, e.g. "2026-W44"
  status            String   @default("BIDDING") // BIDDING|ARMED|ACTIVE|SETTLING|RESOLVED|CANCELLED
  bidOpensAt        DateTime
  bidClosesAt       DateTime
  startsAt          DateTime
  endsAt            DateTime
  topBid            Float    @default(0)      // escrow, always from earnings; burned at settlement
  topBidderFamilyId String   @default("")
  attackerFamilyId  String   @default("")
  defenderFamilyId  String   @default("")     // "" = Street NPC
  seed              String   @default("")     // set at ACTIVE, never rendered
  atkDocks          Int      @default(0)
  atkMain           Int      @default(0)
  atkAlleys         Int      @default(0)
  defDocks          Int      @default(0)
  defMain           Int      @default(0)
  defAlleys         Int      @default(0)      // def* seeded with the class baseline at ACTIVE
  winnerFamilyId    String   @default("")
  warnedSoon        Boolean  @default(false)
  lastTickAt        DateTime @default(now())  // written by each minute tick while ACTIVE
  maxTickGapSeconds Int      @default(0)      // > 600 at settlement → CANCELLED, bid refunded
  boards            Json?                     // the two home-channel boards [{guildId,channelId,messageId,side}], never filtered
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([racketId, periodKey])
  @@index([status, bidClosesAt])
  @@index([status, startsAt])
  @@index([status, endsAt])
  @@index([topBidderFamilyId, status])
}

model WarContribution {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  warId         String   @db.ObjectId
  familyId      String   @db.ObjectId
  userId        String
  side          String                        // ATK|DEF
  hits          Int      @default(0)
  correctHits   Int      @default(0)
  points        Int      @default(0)
  nextHitAt     DateTime @default(now())
  lastScoutSlot Int      @default(-1)
  createdAt     DateTime @default(now())
  @@unique([warId, userId])
  @@index([warId, familyId])
  @@index([userId, createdAt])
}

model WarHit {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  warId     String   @db.ObjectId
  familyId  String   @db.ObjectId
  userId    String
  side      String                            // ATK|DEF
  block     String                            // docks|main|alleys
  slot      Int
  deadline  DateTime
  choice    Int      @default(-1)
  state     String   @default("ARMED")        // ARMED|HIT|MISS|TIMEOUT
  points    Int      @default(0)
  createdAt DateTime @default(now())
  @@index([state, deadline])
  @@index([userId, state, createdAt])
  @@index([warId, userId])
  @@index([state, createdAt])                 // the census groupBy (§6.4)
}

model PaydayShare {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  familyId  String   @db.ObjectId
  runKey    String                         // the id of this payday's FamilyLedger "payday" row
  userId    String
  gross     Float
  tax       Float
  net       Float
  paid      Boolean  @default(false)        // CAS: wallet credited
  createdAt DateTime @default(now())
  @@unique([runKey, userId])
  @@index([paid, createdAt])
  @@index([familyId, createdAt])
}

model FamilyVote {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  familyId        String   @db.ObjectId
  status          String   @default("OPEN")   // OPEN|PASSED|FAILED|VOID
  liveSlot        String   @default("LIVE")   // rewritten to id at close: one open vote per family
  announced       Boolean  @default(false)    // CAS: S34 posted and start DMs sent (A42)
  resultAnnounced Boolean  @default(false)    // CAS: result edit and close DMs sent (A42)
  reposted        Boolean  @default(false)    // the one S34 repost of F9 is spent
  cooldownUntil   DateTime @default(now())    // rewritten at close: closedAt + 7 d on FAILED and counted VOIDs (A46), else closedAt
  bossId          String                      // the Boss the vote targets
  starterId       String
  eligibleIds     String[]                    // snapshot at open; never filtered
  closesAt        DateTime
  ballotsVersion  Int      @default(0)        // written by every ballot so ballot and close conflict
  closedAt        DateTime @default(now())    // rewritten at close; read only with status ≠ OPEN
  yes             Int      @default(0)        // written at close
  no              Int      @default(0)
  eligibleAtClose Int      @default(0)
  newBossId       String   @default("")
  channelId       String   @default("")
  messageId       String   @default("")       // S34; "" = dead or never posted
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([familyId, liveSlot])
  @@index([status, closesAt])
  @@index([familyId, cooldownUntil])
  @@index([announced, createdAt])
  @@index([resultAnnounced, closedAt])
}

model FamilyBallot {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  voteId   String   @db.ObjectId
  familyId String   @db.ObjectId
  userId   String
  choice   String                              // YES|NO
  castAt   DateTime @default(now())
  @@unique([voteId, userId])
}

model CfJobRun {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  key    String   @unique                     // "turf_census"
  dayKey String   @default("")
  ranAt  DateTime @default(now())
}

model BotProcessBoot {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  shardIds Int[]                              // [] when unsharded
  bootedAt DateTime @default(now())
  @@index([bootedAt])
}
